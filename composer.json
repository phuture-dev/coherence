{
    "name": "phuture/coherence",
    "description": "",
    "type": "library",
    "keywords": [
        "php", "array", "hash", "html", "multibyte", "string", "url", "polyfill", "helpers"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Phuture",
            "homepage": "https://www.phuture.dev"
        },
        {
            "name": "Advandz Technologies, LLC",
            "homepage": "https://www.advandz.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "nette/utils": "~4.0.0",
        "nette/php-generator": "~4.2.0",
        "symfony/polyfill-php82": "~v1.33.0",
        "symfony/polyfill-php83": "~v1.33.0",
        "symfony/polyfill-php84": "~v1.33.0",
        "symfony/polyfill-php85": "~v1.33.0",
        "symfony/polyfill-mbstring": "~v1.33.0",
        "symfony/polyfill-iconv": "~v1.33.0",
        "symfony/polyfill-uuid": "~v1.33.0",
        "symfony/polyfill-intl-grapheme": "~v1.33.0",
        "symfony/polyfill-intl-idn": "~v1.33.0",
        "symfony/polyfill-intl-icu": "~v1.33.0",
        "symfony/polyfill-intl-messageformatter": "~v1.33.0",
        "symfony/polyfill-intl-normalizer": "~v1.33.0"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.92.0"
    },
    "autoload": {
        "psr-4": {
            "Phuture\\Coherence\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phuture\\Coherence\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": ["@php-cs-fixer", "@test"],
        "test": ["@phpstan", "@phpcs", "@tester"],
        "server": "php -S localhost:8000",
        "php-cs-fixer": "php-cs-fixer fix",
        "phpstan": "phpstan analyse src --memory-limit=4294967296",
        "phpcs": "phpcs --standard=PSR12 src",
        "tester": "tester tests -C"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
