<?xml version="1.0"?>
<ruleset name="Coherence">
    <description>Coding standard for Phuture/Coherence</description>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <arg name="colors"/>
    <arg value="s"/>
</ruleset>
